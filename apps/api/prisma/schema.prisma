// Makeup Pro — cấu trúc dữ liệu.
// Luật: mọi bảng nghiệp vụ có organization_id; tiền là BigInt (đồng); thời gian là timestamptz (UTC).
// Không xoá dây chuyền (cascade) dữ liệu nghiệp vụ: xoá tổ chức bị chặn khi còn dữ liệu.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum OrganizationKind {
  INDIVIDUAL
  TEAM
  ACADEMY
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  fullName     String     @map("full_name")
  phone        String?
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships          Membership[]
  refreshTokens        RefreshToken[]
  auditLogs            AuditLog[]
  appointmentsCreated  Appointment[]              @relation("AppointmentCreatedBy")
  contractsCreated     Contract[]                 @relation("ContractCreatedBy")
  contractLinesCreated ContractLine[]             @relation("ContractLineCreatedBy")
  priceVersionsCreated PriceVersion[]             @relation("PriceVersionCreatedBy")
  statusChanges        AppointmentStatusHistory[] @relation("StatusChangedBy")
  payRatesUpdated      StaffPayRate[]             @relation("PayRateUpdatedBy")
  idempotencyKeys      IdempotencyKey[]
  filesCreated         StoredFile[]
  paymentsCreated      Payment[]                  @relation("PaymentCreatedBy")
  platformAdmin        PlatformAdmin?             @relation("PlatformAdminUser")

  @@map("users")
}

enum RevokeReason {
  ROTATED
  LOGOUT
  REUSE_DETECTED
}

model RefreshToken {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  familyId     String        @map("family_id") @db.Uuid
  tokenHash    String        @unique @map("token_hash")
  expiresAt    DateTime      @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime?     @map("revoked_at") @db.Timestamptz(3)
  // Lý do thu hồi: chỉ thẻ bị thu hồi do XOAY VÒNG mà đem dùng lại mới là dấu hiệu đánh cắp.
  revokeReason RevokeReason? @map("revoke_reason")
  replacedById String?       @map("replaced_by_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Organization {
  id        String             @id @default(uuid()) @db.Uuid
  slug      String             @unique
  name      String
  kind      OrganizationKind
  timezone  String             @default("Asia/Ho_Chi_Minh")
  currency  String             @default("VND")
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles           Role[]
  memberships     Membership[]
  membershipRoles MembershipRole[]
  auditLogs       AuditLog[]

  serviceCategories ServiceCategory[]
  services          Service[]
  packages          ServicePackage[]
  packageItems      PackageItem[]
  priceVersions     PriceVersion[]
  customers         Customer[]
  appointments      Appointment[]
  appointmentStaff  AppointmentStaff[]
  statusHistory     AppointmentStatusHistory[]
  counters          OrgCounter[]
  idempotencyKeys   IdempotencyKey[]
  makeupSubjects    MakeupSubject[]
  studioLocations   StudioLocation[]
  travelFeePolicy   TravelFeePolicy?
  contracts         Contract[]
  contractLines     ContractLine[]
  staffTiers        StaffTier[]
  staffProfiles     StaffProfile[]
  staffPayRates     StaffPayRate[]
  contractLineStaff ContractLineStaff[]
  storedFiles       StoredFile[]
  installments      PaymentInstallment[]
  payments          Payment[]
  subscriptions     OrganizationSubscription[]
  profile           OrganizationProfile?

  @@map("organizations")
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String
  name           String
  isSystem       Boolean  @default(false) @map("is_system")
  // Khoá quyền lấy từ danh mục @makeup/shared; máy chủ từ chối khoá lạ.
  permissions    String[]
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  membershipRoles MembershipRole[]

  @@unique([organizationId, key])
  // Cho phép khoá ngoại kép (id, organization_id) để database tự chặn gán vai trò khác tổ chức.
  @@unique([id, organizationId])
  @@map("roles")
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user              User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles             MembershipRole[]
  assignments       AppointmentStaff[]
  staffProfile      StaffProfile?
  contractLineStaff ContractLineStaff[]

  @@unique([organizationId, userId])
  @@unique([id, organizationId])
  @@index([userId])
  @@map("memberships")
}

model MembershipRole {
  organizationId String @map("organization_id") @db.Uuid
  membershipId   String @map("membership_id") @db.Uuid
  roleId         String @map("role_id") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  membership   Membership   @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Cascade)
  role         Role         @relation(fields: [roleId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@id([membershipId, roleId])
  @@index([roleId])
  @@map("membership_roles")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  data           Json?
  requestId      String?  @map("request_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

// ==================== BẢNG GIÁ ====================

model ServiceCategory {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  services     Service[]

  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@map("service_categories")
}

enum ServiceKind {
  // Dịch vụ chính (makeup cô dâu, makeup tiệc…)
  MAIN
  // Dịch vụ phụ tick thêm (làm tóc, nail, lens…)
  ADDON
  // Phụ phí cài sẵn (ca sớm, ngoài giờ, thêm người…)
  SURCHARGE
}

// Nơi thực hiện: tại studio/cửa hàng, tại nhà khách, hoặc địa điểm khác.
// Tại nhà và địa điểm khác thì hợp đồng tính phí di chuyển.
enum LocationType {
  STUDIO
  CUSTOMER_HOME
  OTHER
}

model Service {
  id              String      @id @default(uuid()) @db.Uuid
  organizationId  String      @map("organization_id") @db.Uuid
  categoryId      String?     @map("category_id") @db.Uuid
  kind            ServiceKind @default(MAIN)
  code            String
  name            String
  description     String?
  durationMinutes Int         @map("duration_minutes")
  isActive        Boolean     @default(true) @map("is_active")
  // Hiện trên website giới thiệu hay không (website chỉ đọc dịch vụ isActive && isPublic).
  isPublic        Boolean     @default(false) @map("is_public")
  sortOrder       Int         @default(0) @map("sort_order")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category      ServiceCategory? @relation(fields: [categoryId, organizationId], references: [id, organizationId], onDelete: Restrict)
  prices        PriceVersion[]
  packageItems  PackageItem[]
  contractLines ContractLine[]
  payRates      StaffPayRate[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@map("services")
}

model ServicePackage {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  code            String
  name            String
  description     String?
  durationMinutes Int            @map("duration_minutes")
  staffCount      Int            @default(1) @map("staff_count")
  // Tiền cọc mặc định khi chốt lịch theo gói (đồng).
  depositAmount   BigInt         @default(0) @map("deposit_amount")
  // Nhân vật makeup áp dụng (cô dâu, mẹ, phù dâu…); null = mọi nhân vật.
  subjectId       String?        @map("subject_id") @db.Uuid
  // Địa điểm gói cho phép chọn. Rỗng = không giới hạn.
  locationTypes   LocationType[] @map("location_types")
  // Bán kính miễn phí của gói khi làm tại nhà / địa điểm khác (km một chiều). Trống = theo mức chung của tổ chức.
  includedKm      Decimal?       @map("included_km") @db.Decimal(7, 2)
  terms           String?
  isActive        Boolean        @default(true) @map("is_active")
  isPublic        Boolean        @default(false) @map("is_public")
  sortOrder       Int            @default(0) @map("sort_order")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subject       MakeupSubject? @relation(fields: [subjectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  items         PackageItem[]
  payRates      StaffPayRate[]
  contractLines ContractLine[]
  prices        PriceVersion[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@map("service_packages")
}

model PackageItem {
  organizationId String  @map("organization_id") @db.Uuid
  packageId      String  @map("package_id") @db.Uuid
  serviceId      String  @map("service_id") @db.Uuid
  quantity       Int     @default(1)
  isOptional     Boolean @default(false) @map("is_optional")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  package      ServicePackage @relation(fields: [packageId, organizationId], references: [id, organizationId], onDelete: Cascade)
  service      Service        @relation(fields: [serviceId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@id([packageId, serviceId])
  @@map("package_items")
}

// Lịch sử giá: không bao giờ sửa dòng cũ, đổi giá = thêm dòng mới. Giá hiện hành = dòng mới nhất có effective_from <= bây giờ.
// Mỗi dòng thuộc đúng một dịch vụ HOẶC một gói (chốt bằng CHECK trong migration).
model PriceVersion {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  serviceId      String?  @map("service_id") @db.Uuid
  packageId      String?  @map("package_id") @db.Uuid
  listPrice      BigInt   @map("list_price")
  salePrice      BigInt?  @map("sale_price")
  effectiveFrom  DateTime @map("effective_from") @db.Timestamptz(3)
  note           String?
  createdById    String   @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  service       Service?        @relation(fields: [serviceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  package       ServicePackage? @relation(fields: [packageId, organizationId], references: [id, organizationId], onDelete: Restrict)
  contractLines ContractLine[]
  createdBy     User            @relation("PriceVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([id, organizationId])
  @@index([serviceId, effectiveFrom])
  @@index([packageId, effectiveFrom])
  @@map("price_versions")
}

// ==================== KHÁCH HÀNG & LỊCH ====================

model Customer {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  fullName       String   @map("full_name")
  // Số điện thoại đã chuẩn hoá về dạng 0xxxxxxxxx.
  phone          String?
  email          String?
  note           String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  appointments Appointment[]
  contracts    Contract[]

  @@unique([id, organizationId])
  @@index([organizationId, phone])
  @@map("customers")
}

enum EventKind {
  MAKEUP
  COURSE_SESSION
  INTERNAL
  PERSONAL_BLOCK
  OTHER
}

// Trạng thái THỰC HIỆN. Trạng thái THANH TOÁN không nằm ở đây: nó sẽ suy ra từ sổ giao dịch (module tài chính).
enum WorkStatus {
  DRAFT
  PENDING_CONFIRMATION
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum StaffRole {
  PRIMARY
  ASSIST
}

model Appointment {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  code            String
  kind            EventKind     @default(MAKEUP)
  title           String?
  customerId      String?       @map("customer_id") @db.Uuid
  startsAt        DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime      @map("ends_at") @db.Timestamptz(3)
  // Phút di chuyển trước/sau lịch — tính vào khoảng bận của thợ khi chặn trùng.
  travelBeforeMin Int           @default(0) @map("travel_before_min")
  travelAfterMin  Int           @default(0) @map("travel_after_min")
  address         String?
  latitude        Decimal?      @db.Decimal(9, 6)
  longitude       Decimal?      @db.Decimal(9, 6)
  status          WorkStatus    @default(DRAFT)
  locationType    LocationType? @map("location_type")
  // Lịch sinh từ hợp đồng thì trỏ về hợp đồng và dòng hợp đồng. Tiền nằm ở hợp đồng, lịch không giữ tiền.
  contractId      String?       @map("contract_id") @db.Uuid
  contractLineId  String?       @map("contract_line_id") @db.Uuid
  notes           String?
  cancelReason    String?       @map("cancel_reason")
  createdById     String        @map("created_by_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization           Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer               Customer?                  @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  contract               Contract?                  @relation(fields: [contractId, organizationId], references: [id, organizationId], onDelete: Restrict)
  contractLine           ContractLine?              @relation(fields: [contractLineId, organizationId], references: [id, organizationId], onDelete: Restrict)
  // Dòng hợp đồng phải thuộc CHÍNH hợp đồng của lịch (database tự chặn).
  contractLineInContract ContractLine?              @relation("AppointmentLineOfContract", fields: [contractLineId, contractId], references: [id, contractId], onDelete: Restrict)
  createdBy              User                       @relation("AppointmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  staff                  AppointmentStaff[]
  statusHistory          AppointmentStatusHistory[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, startsAt])
  @@map("appointments")
}

model AppointmentStaff {
  organizationId String    @map("organization_id") @db.Uuid
  appointmentId  String    @map("appointment_id") @db.Uuid
  membershipId   String    @map("membership_id") @db.Uuid
  role           StaffRole @default(PRIMARY)
  // Khoảng bận = giờ bắt đầu − di chuyển trước → giờ kết thúc + di chuyển sau.
  blockStart     DateTime  @map("block_start") @db.Timestamptz(3)
  blockEnd       DateTime  @map("block_end") @db.Timestamptz(3)
  // false khi lịch ở trạng thái không chiếm giờ (nháp, đã huỷ, khách không đến).
  isBlocking     Boolean   @map("is_blocking")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  appointment  Appointment  @relation(fields: [appointmentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  membership   Membership   @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@id([appointmentId, membershipId])
  @@index([membershipId, blockStart])
  @@map("appointment_staff")
}

model AppointmentStatusHistory {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  appointmentId  String      @map("appointment_id") @db.Uuid
  fromStatus     WorkStatus? @map("from_status")
  toStatus       WorkStatus  @map("to_status")
  reason         String?
  changedById    String      @map("changed_by_id") @db.Uuid
  changedAt      DateTime    @default(now()) @map("changed_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  appointment  Appointment  @relation(fields: [appointmentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  changedBy    User         @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([appointmentId, changedAt])
  @@map("appointment_status_history")
}

// ==================== HỆ THỐNG ====================

// Bộ đếm theo tổ chức để sinh mã lịch tuần tự (LH-000001) không trùng khi gửi đồng thời.
model OrgCounter {
  organizationId String @map("organization_id") @db.Uuid
  key            String
  value          Int    @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@id([organizationId, key])
  @@map("org_counters")
}

// Chống gửi trùng: cùng khoá + cùng nội dung trả lại đúng kết quả lần đầu, không tạo bản ghi thứ hai.
model IdempotencyKey {
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  key            String
  routeKey       String   @map("route_key")
  requestHash    String   @map("request_hash")
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([organizationId, userId, key])
  @@map("idempotency_keys")
}

// ==================== NHÂN VẬT, ĐỊA ĐIỂM, PHÍ DI CHUYỂN ====================

// Nhân vật makeup: cô dâu, chú rể, mẹ cô dâu, phù dâu… Mỗi tổ chức tự thêm, sửa, ẩn.
model MakeupSubject {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  packages      ServicePackage[]
  contractLines ContractLine[]

  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@map("makeup_subjects")
}

// Studio / cửa hàng của tổ chức — điểm xuất phát để tính km.
model StudioLocation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  address        String
  latitude       Decimal? @db.Decimal(9, 6)
  longitude      Decimal? @db.Decimal(9, 6)
  isDefault      Boolean  @default(false) @map("is_default")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contractLines ContractLine[]

  @@unique([id, organizationId])
  @@map("studio_locations")
}

enum TravelFeeMode {
  // Một mức cố định mỗi lần đi
  FIXED
  // Đơn giá × số km (trừ số km miễn phí), không thấp hơn mức tối thiểu
  PER_KM
  // Nhập tay theo thoả thuận với từng khách
  MANUAL
  // Theo bậc khoảng cách (bảng travel_fee_tiers): vd 10–20 km: 200.000 ₫, 20–30 km: 400.000 ₫
  TIERED
}

// Cách tính phí di chuyển mặc định của tổ chức. Khi lập hợp đồng vẫn được chọn cách khác cho từng dòng.
model TravelFeePolicy {
  organizationId String        @id @map("organization_id") @db.Uuid
  defaultMode    TravelFeeMode @default(MANUAL) @map("default_mode")
  fixedAmount    BigInt        @default(0) @map("fixed_amount")
  perKmAmount    BigInt        @default(0) @map("per_km_amount")
  freeKm         Decimal       @default(0) @map("free_km") @db.Decimal(7, 2)
  minimumAmount  BigInt        @default(0) @map("minimum_amount")
  // true = tính cả chiều đi và chiều về
  roundTrip      Boolean       @default(false) @map("round_trip")
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tiers        TravelFeeTier[]

  @@map("travel_fee_policies")
}

// Bậc phí di chuyển theo khoảng cách MỘT CHIỀU. Trong bán kính miễn phí thì 0 đ; vượt thì tra bảng:
// khoảng cách trong [fromKm, toKm) → thu amount. toKm trống = bậc cuối (từ fromKm trở lên).
model TravelFeeTier {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  fromKm         Decimal  @map("from_km") @db.Decimal(7, 2)
  toKm           Decimal? @map("to_km") @db.Decimal(7, 2)
  amount         BigInt

  policy TravelFeePolicy @relation(fields: [organizationId], references: [organizationId], onDelete: Cascade)

  @@unique([organizationId, fromKm])
  @@map("travel_fee_tiers")
}

// ==================== HỢP ĐỒNG ====================

enum ContractStatus {
  DRAFT
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ContractLineKind {
  PACKAGE
  SERVICE
  ADDON
  SURCHARGE
  TRAVEL
  CUSTOM
}

// Hợp đồng là nơi DUY NHẤT giữ tiền của một đơn makeup.
// Luật: subtotal = tổng line_total các dòng chưa huỷ; total = subtotal − discount (máy chủ tự tính, bài thử kiểm).
model Contract {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  code            String
  customerId      String         @map("customer_id") @db.Uuid
  status          ContractStatus @default(DRAFT)
  eventDate       DateTime?      @map("event_date") @db.Timestamptz(3)
  subtotal        BigInt         @default(0)
  discount        BigInt         @default(0)
  total           BigInt         @default(0)
  depositRequired BigInt         @default(0) @map("deposit_required")
  notes           String?
  terms           String?
  cancelReason    String?        @map("cancel_reason")
  confirmedAt     DateTime?      @map("confirmed_at") @db.Timestamptz(3)
  createdById     String         @map("created_by_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     Customer             @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  lines        ContractLine[]
  appointments Appointment[]
  installments PaymentInstallment[]
  payments     Payment[]
  createdBy    User                 @relation("ContractCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, eventDate])
  @@map("contracts")
}

// Một dòng hợp đồng. Giá chốt lúc thêm dòng (unit_price + price_version_id): đổi bảng giá sau không đổi hợp đồng.
// Dịch vụ phụ (ADDON) gắn vào dòng gói qua parent_line_id.
// Sau khi hợp đồng xác nhận: không sửa/xoá dòng cũ; chỉ thêm dòng phát sinh hoặc huỷ dòng có lý do.
model ContractLine {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  contractId        String           @map("contract_id") @db.Uuid
  parentLineId      String?          @map("parent_line_id") @db.Uuid
  kind              ContractLineKind
  serviceId         String?          @map("service_id") @db.Uuid
  packageId         String?          @map("package_id") @db.Uuid
  priceVersionId    String?          @map("price_version_id") @db.Uuid
  subjectId         String?          @map("subject_id") @db.Uuid
  subjectName       String?          @map("subject_name")
  name              String
  locationType      LocationType?    @map("location_type")
  studioLocationId  String?          @map("studio_location_id") @db.Uuid
  address           String?
  latitude          Decimal?         @db.Decimal(9, 6)
  longitude         Decimal?         @db.Decimal(9, 6)
  scheduledStart    DateTime?        @map("scheduled_start") @db.Timestamptz(3)
  scheduledEnd      DateTime?        @map("scheduled_end") @db.Timestamptz(3)
  quantity          Int              @default(1)
  unitPrice         BigInt           @map("unit_price")
  lineDiscount      BigInt           @default(0) @map("line_discount")
  lineTotal         BigInt           @map("line_total")
  // Chỉ dùng cho dòng TRAVEL: cách tính và số liệu đã dùng để tính.
  travelMode        TravelFeeMode?   @map("travel_mode")
  distanceKm        Decimal?         @map("distance_km") @db.Decimal(7, 2)
  perKmAmount       BigInt?          @map("per_km_amount")
  note              String?
  sortOrder         Int              @default(0) @map("sort_order")
  addedAfterConfirm Boolean          @default(false) @map("added_after_confirm")
  voidedAt          DateTime?        @map("voided_at") @db.Timestamptz(3)
  voidReason        String?          @map("void_reason")
  createdById       String           @map("created_by_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organization           Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contract               Contract            @relation(fields: [contractId, organizationId], references: [id, organizationId], onDelete: Restrict)
  parent                 ContractLine?       @relation("LineAddons", fields: [parentLineId, organizationId], references: [id, organizationId], onDelete: Restrict)
  addons                 ContractLine[]      @relation("LineAddons")
  service                Service?            @relation(fields: [serviceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  package                ServicePackage?     @relation(fields: [packageId, organizationId], references: [id, organizationId], onDelete: Restrict)
  subject                MakeupSubject?      @relation(fields: [subjectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  studioLocation         StudioLocation?     @relation(fields: [studioLocationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  appointments           Appointment[]
  appointmentsInContract Appointment[]       @relation("AppointmentLineOfContract")
  plannedStaff           ContractLineStaff[]
  priceVersion           PriceVersion?       @relation(fields: [priceVersionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdBy              User                @relation("ContractLineCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([id, organizationId])
  @@unique([id, contractId])
  @@index([contractId])
  @@map("contract_lines")
}

// ==================== NHÂN SỰ & BẬC LƯƠNG ====================

// Bậc lương do tổ chức tự đặt (Thợ chính bậc 1, Thợ chính bậc 2, Thợ phụ…).
model StaffTier {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  profiles     StaffProfile[]
  payRates     StaffPayRate[]

  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@map("staff_tiers")
}

// Hồ sơ thợ trong một tổ chức (1–1 với thành viên): tên hiển thị, ảnh đại diện, bậc lương.
model StaffProfile {
  membershipId   String   @id @map("membership_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  displayName    String?  @map("display_name")
  // Đường dẫn ảnh đại diện; tải ảnh lên làm cùng module lưu trữ tệp. Trống → giao diện hiện chữ viết tắt.
  avatarUrl      String?  @map("avatar_url")
  phone          String?
  tierId         String?  @map("tier_id") @db.Uuid
  isBookable     Boolean  @default(true) @map("is_bookable")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  membership   Membership   @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  tier         StaffTier?   @relation(fields: [tierId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([membershipId, organizationId])
  @@index([organizationId, tierId])
  @@map("staff_profiles")
}

// Tiền công thợ cho MỘT gói hoặc MỘT dịch vụ, theo từng bậc lương.
// Lúc trả lương sẽ chụp lại số tiền (bảng chi trả thuộc module tài chính) — sửa mức công sau không đổi khoản đã trả.
model StaffPayRate {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  packageId      String?  @map("package_id") @db.Uuid
  serviceId      String?  @map("service_id") @db.Uuid
  tierId         String   @map("tier_id") @db.Uuid
  amount         BigInt
  updatedById    String   @map("updated_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  package      ServicePackage? @relation(fields: [packageId, organizationId], references: [id, organizationId], onDelete: Restrict)
  service      Service?        @relation(fields: [serviceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  tier         StaffTier       @relation(fields: [tierId, organizationId], references: [id, organizationId], onDelete: Restrict)
  updatedBy    User            @relation("PayRateUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([packageId, tierId])
  @@unique([serviceId, tierId])
  @@map("staff_pay_rates")
}

// Thợ dự kiến cho một dòng hợp đồng (chọn lúc tư vấn). Khi hợp đồng được XÁC NHẬN, máy chủ tạo lịch
// cho dòng có giờ + thợ; từ đó lịch là nơi duy nhất giữ giờ thợ (đổi thợ làm ở màn Lịch).
model ContractLineStaff {
  organizationId String    @map("organization_id") @db.Uuid
  lineId         String    @map("line_id") @db.Uuid
  membershipId   String    @map("membership_id") @db.Uuid
  role           StaffRole @default(PRIMARY)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  line         ContractLine @relation(fields: [lineId, organizationId], references: [id, organizationId], onDelete: Cascade)
  membership   Membership   @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@id([lineId, membershipId])
  @@index([membershipId])
  @@map("contract_line_staff")
}

// ==================== LƯU TRỮ TỆP ====================

enum FilePurpose {
  STAFF_AVATAR
  CUSTOMER_AVATAR
  ORG_LOGO
  ALBUM_IMAGE
  COURSE_RESOURCE
  SUBMISSION
  WELCOME_CARD
  OTHER
}

enum FileStatus {
  UPLOADING
  READY
  DELETED
}

// Tệp không nằm trong database — database chỉ giữ thông tin và khoá lưu trữ (storage_key).
model StoredFile {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  purpose        FilePurpose
  storageKey     String      @unique @map("storage_key")
  originalName   String      @map("original_name")
  mimeType       String      @map("mime_type")
  sizeBytes      BigInt      @map("size_bytes")
  sha256         String?
  width          Int?
  height         Int?
  status         FileStatus  @default(UPLOADING)
  isPublic       Boolean     @default(false) @map("is_public")
  createdById    String      @map("created_by_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Restrict)

  profileLogos   OrganizationProfile[] @relation("ProfileLogo")
  profileAvatars OrganizationProfile[] @relation("ProfileAvatar")
  profileCovers  OrganizationProfile[] @relation("ProfileCover")

  @@unique([id, organizationId])
  @@index([organizationId, purpose])
  @@map("stored_files")
}

// ==================== THU TIỀN ====================

// Tiến độ thanh toán: các đợt dự kiến của một hợp đồng (cọc, đợt 1, đợt 2…).
model PaymentInstallment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  contractId     String   @map("contract_id") @db.Uuid
  name           String
  dueDate        DateTime @map("due_date") @db.Timestamptz(3)
  amount         BigInt
  isDeposit      Boolean  @default(false) @map("is_deposit")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contract     Contract     @relation(fields: [contractId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([contractId])
  @@map("payment_installments")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

enum PaymentKind {
  // Tiền khách trả vào
  RECEIPT
  // Tiền trả lại khách
  REFUND
}

// Phiếu thu / phiếu hoàn: CHỈ GHI THÊM. Ghi sai thì huỷ phiếu có lý do, không sửa, không xoá.
model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  contractId     String        @map("contract_id") @db.Uuid
  code           String
  kind           PaymentKind   @default(RECEIPT)
  method         PaymentMethod
  amount         BigInt
  receivedAt     DateTime      @map("received_at") @db.Timestamptz(3)
  note           String?
  voidedAt       DateTime?     @map("voided_at") @db.Timestamptz(3)
  voidReason     String?       @map("void_reason")
  createdById    String        @map("created_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contract     Contract     @relation(fields: [contractId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdBy    User         @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([organizationId, code])
  @@index([contractId])
  @@index([organizationId, receivedAt])
  @@map("payments")
}

// ==================== QUẢN TRỊ NỀN TẢNG ====================

// Người quản trị toàn nền tảng (không thuộc tổ chức nào). Không có mật khẩu chung — đăng nhập bằng tài khoản riêng.
model PlatformAdmin {
  userId      String   @id @map("user_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid

  user User @relation("PlatformAdminUser", fields: [userId], references: [id], onDelete: Restrict)

  @@map("platform_admins")
}

// Gói thuê bao. Giới hạn null = không giới hạn.
model SubscriptionPlan {
  id                      String   @id @default(uuid()) @db.Uuid
  code                    String   @unique
  name                    String
  priceMonthly            BigInt   @map("price_monthly")
  maxStaff                Int?     @map("max_staff")
  maxAppointmentsPerMonth Int?     @map("max_appointments_per_month")
  maxStorageMb            Int?     @map("max_storage_mb")
  maxStudents             Int?     @map("max_students")
  maxCourses              Int?     @map("max_courses")
  customDomain            Boolean  @default(false) @map("custom_domain")
  features                String[]
  isActive                Boolean  @default(true) @map("is_active")
  sortOrder               Int      @default(0) @map("sort_order")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  subscriptions OrganizationSubscription[]

  @@map("subscription_plans")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELLED
}

// Lịch sử thuê bao của tổ chức: mỗi lần đổi gói/gia hạn là một dòng mới. Hết hạn KHÔNG xoá dữ liệu.
model OrganizationSubscription {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  planId         String             @map("plan_id") @db.Uuid
  status         SubscriptionStatus
  startsAt       DateTime           @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime?          @map("ends_at") @db.Timestamptz(3)
  note           String?
  createdById    String?            @map("created_by_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plan         SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([organizationId, startsAt])
  @@map("organization_subscriptions")
}

// ==================== HỒ SƠ THƯƠNG HIỆU (website giới thiệu đọc bản đã xuất bản) ====================

// Hồ sơ công khai của tổ chức. Website chỉ đọc khi isPublished = true; sửa xong phải bấm xuất bản lại.
model OrganizationProfile {
  organizationId     String    @id @map("organization_id") @db.Uuid
  brandName          String    @map("brand_name")
  tagline            String?
  bio                String?
  experience         String?
  styles             String[]
  serviceArea        String?   @map("service_area")
  address            String?
  phone              String?
  email              String?
  zalo               String?
  facebook           String?
  instagram          String?
  tiktok             String?
  website            String?
  logoFileId         String?   @map("logo_file_id") @db.Uuid
  avatarFileId       String?   @map("avatar_file_id") @db.Uuid
  coverFileId        String?   @map("cover_file_id") @db.Uuid
  // Giờ làm việc theo thứ trong tuần: [{ weekday: 1..7, open: "08:00", close: "20:00" }] — kiểm bằng zod ở máy chủ.
  workingHours       Json      @default("[]") @map("working_hours")
  bookingPolicy      String?   @map("booking_policy")
  cancellationPolicy String?   @map("cancellation_policy")
  depositPolicy      String?   @map("deposit_policy")
  isPublished        Boolean   @default(false) @map("is_published")
  publishedAt        DateTime? @map("published_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  // Khoá ngoại kép (tệp, tổ chức): database chặn gắn ảnh của tổ chức khác.
  logo         StoredFile?  @relation("ProfileLogo", fields: [logoFileId, organizationId], references: [id, organizationId], onDelete: Restrict)
  avatar       StoredFile?  @relation("ProfileAvatar", fields: [avatarFileId, organizationId], references: [id, organizationId], onDelete: Restrict)
  cover        StoredFile?  @relation("ProfileCover", fields: [coverFileId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@map("organization_profiles")
}
