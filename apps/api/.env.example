# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit tệp .env.
NODE_ENV=development
PORT=4000
# Supabase: chuỗi qua pooler (cổng 6543, thêm ?pgbouncer=true) cho máy chủ chạy
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
# Supabase: chuỗi kết nối thẳng (cổng 5432) cho lệnh migrate
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# Chuỗi ngẫu nhiên ≥ 32 ký tự, mỗi môi trường một chuỗi khác nhau
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Danh sách tên miền web được gọi API, cách nhau dấu phẩy
CORS_ORIGINS=http://localhost:5173
AUTH_RATE_LIMIT_PER_MINUTE=10
# Đổi thẻ đăng nhập (/auth/refresh), theo IP mỗi phút — web gọi mỗi lần tải trang nên tách khỏi bộ đếm đăng nhập.
# Bỏ trống → mặc định: số lần đổi thẻ SAI = 3 × AUTH_RATE_LIMIT_PER_MINUTE; trần tổng = 30 × AUTH_RATE_LIMIT_PER_MINUTE.
REFRESH_PROBE_LIMIT_PER_MINUTE=
REFRESH_RATE_LIMIT_PER_MINUTE=
# Mở cổng học viên (POST /portal/session, /portal/session/claim), theo IP mỗi phút — bộ đếm RIÊNG, không ăn vào hạn mức
# đăng nhập nhân viên. Không khai dòng này → 10. Khai sai (0, chữ, để trống "=") → máy chủ KHÔNG khởi động (lỗi nêu tên biến).
PORTAL_RATE_LIMIT_PER_MINUTE=10
# Railway có 1 tầng proxy phía trước → 1. Chạy thẳng không proxy → 0.
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
# ===== Kho tệp (ảnh đại diện, logo, album, tài liệu) =====
# local = đĩa của máy chủ (dev/test, hoặc máy chủ có ổ bền); s3 = dịch vụ giao thức S3 (Supabase Storage, AWS S3, R2).
# Production BẮT BUỘC khai STORAGE_DRIVER và đủ biến của driver đó — thiếu thì máy chủ KHÔNG khởi động (lỗi nêu tên biến).
# development/test bỏ trống thì dùng thư mục tạm của máy.
# RAILWAY: ổ đĩa của dịch vụ bị XOÁ mỗi lần khởi động lại/triển khai lại (trừ khi gắn Volume) → production nên dùng s3.
STORAGE_DRIVER=local
# local: thư mục gốc lưu tệp (production bắt buộc)
STORAGE_LOCAL_DIR=
# local: khoá ký URL đọc tệp, chuỗi ngẫu nhiên ≥ 32 ký tự, KHÁC JWT_ACCESS_SECRET (production bắt buộc)
STORAGE_SIGNING_SECRET=
# local: địa chỉ công khai của API, ví dụ https://api.makeup.vn (production bắt buộc; URL ký = <địa chỉ>/api/v1/files/raw/<vé>)
STORAGE_PUBLIC_BASE_URL=
# s3: CẢ 6 biến S3_* bắt buộc khi STORAGE_DRIVER=s3 (mọi môi trường).
# S3_ENDPOINT: Supabase → https://<project>.supabase.co/storage/v1/s3 ; AWS → https://s3.<region>.amazonaws.com
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Supabase/MinIO: true ; AWS kiểu tên miền theo bucket: false
S3_FORCE_PATH_STYLE=true
# ===== Gửi thư (đặt lại mật khẩu qua email) — đọc ở src/lib/mailer/index.ts =====
# console = in nguyên thư (KỂ CẢ đường dẫn đặt lại bí mật) ra nhật ký máy chủ — CHỈ để chạy thử; production từ chối driver này.
# http    = gọi API gửi thư qua HTTPS (dịch vụ gửi thư giao dịch).
# Bỏ trống: development/test → console; production → đường quên mật khẩu trả 503 NOT_CONFIGURED (lỗi ghi rõ biến thiếu).
MAIL_DRIVER=console
# Người gửi hiện trong thư, ví dụ: MAIL_FROM="Makeup Pro <no-reply@makeup.vn>" (giữ dấu nháy vì có khoảng trắng).
# Bắt buộc khi MAIL_DRIVER=http (thiếu → máy chủ KHÔNG khởi động, lỗi nêu tên biến).
MAIL_FROM=
# http: địa chỉ API gửi thư, ví dụ https://api.resend.com/emails (thân JSON {from,to,subject,text,html} + header
# "Authorization: Bearer <khoá>" — dạng của Resend; nhà cung cấp khác thì sửa body() trong src/lib/mailer/http.ts).
# Production BẮT BUỘC https (khoá API không được đi qua http trần). Bắt buộc khi MAIL_DRIVER=http.
MAIL_HTTP_URL=
# http: khoá API của dịch vụ gửi thư (≥ 8 ký tự). BÍ MẬT — chỉ khai trong .env / biến môi trường của nơi triển khai,
# KHÔNG ghi vào tệp này, KHÔNG commit. Bắt buộc khi MAIL_DRIVER=http.
MAIL_HTTP_API_KEY=
# Địa chỉ trang web; đường dẫn trong thư = <WEB_APP_URL>/dat-lai-mat-khau#the=… (không có dấu / ở cuối).
# Production BẮT BUỘC để gửi thư (thiếu → 503 NOT_CONFIGURED); development/test bỏ trống → http://localhost:5173.
WEB_APP_URL=http://localhost:5173
# Thẻ đặt lại mật khẩu hết hạn sau bao nhiêu phút (5–1440). Bỏ trống → 30.
PASSWORD_RESET_TTL_MINUTES=30
