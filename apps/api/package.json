{
  "name": "@makeup/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:sync-roles": "tsx src/scripts/run-sync-system-roles.ts",
    "postinstall": "prisma generate",
    "db:sync-roles:prod": "node dist/scripts/run-sync-system-roles.js",
    "platform:grant-admin": "tsx src/scripts/grant-platform-admin.ts",
    "platform:seed-plans": "tsx src/scripts/seed-plans.ts",
    "platform:grant-admin:prod": "node dist/scripts/grant-platform-admin.js",
    "platform:seed-plans:prod": "node dist/scripts/seed-plans.js"
  },
  "dependencies": {
    "@makeup/shared": "workspace:*",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "prisma": "6.19.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
